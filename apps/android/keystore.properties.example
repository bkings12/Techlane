# Copy this file to keystore.properties (same directory) and fill in real
# values. keystore.properties is gitignored — never commit it, and never
# commit the .jks it points at. See apps/android/RELEASE.md for how the
# TechLane release keystore is generated, stored, and backed up.
#
# Equivalent environment variables (what CI uses instead of this file):
#   TECHLANE_KEYSTORE_PATH, TECHLANE_KEYSTORE_PASSWORD,
#   TECHLANE_KEY_ALIAS, TECHLANE_KEY_PASSWORD
storeFile=/absolute/path/to/techlane-release.jks
storePassword=CHANGE_ME
keyAlias=techlane
keyPassword=CHANGE_ME
