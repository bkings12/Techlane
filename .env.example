APP_ENV=development
JWT_SECRET=dev-change-me-in-production-32chars
# Separate 32+ character secret recommended in production; falls back to JWT_SECRET.
DEVICE_PASSCODE_KEY=dev-device-passcode-key-change-me
DATABASE_URL=postgres://techlane:techlane@localhost:5433/techlane?sslmode=disable
HTTP_ADDR=:8080
CORS_ORIGINS=*
PUBLIC_API_BASE=http://localhost:8080

# Object storage — production uses Cloudflare R2 (see deploy/object-storage.env.example).
# OBJECT_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# OBJECT_STORAGE_BUCKET=techlane
# OBJECT_STORAGE_KEY_PREFIX=attachments
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_ENCRYPTION_KEY=   # openssl rand -hex 32
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Customer OTP SMS (BlessedTexts). Required in production (APP_ENV=production).
# BLESSEDTEXTS_API_KEY=
# BLESSEDTEXTS_SENDER_ID=23107
# BLESSEDTEXTS_BASE_URL=https://sms.blessedtexts.com/api/sms/v1

# WhatsApp Baileys sidecar (estimate YES/NO + supplier QUOTE). Owner links via Settings → WhatsApp.
# WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
# WHATSAPP_SERVICE_SECRET=change-me-shared-with-sidecar
# On the sidecar, set WHATSAPP_INBOUND_URL=http://platform:8080/api/v1/whatsapp/inbound
# (same secret as WHATSAPP_SERVICE_SECRET).

# Optional shared token for M-Pesa webhook URLs (?token=...)
# MPESA_WEBHOOK_TOKEN=

# Web dashboard origin used to build links in emails (password reset, etc.)
# WEB_OPS_BASE_URL=https://app.techlane.co.ke

# Outbound email (forgot-password links). Without these, links are logged, not emailed.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM=TechLane <no-reply@techlane.co.ke>

# Self-serve tenant signup (POST /auth/signup, and the web-ops /signup page).
# Set to "false" on instances that should only ever have staff created by an
# existing owner (Settings > Staff), not public self-registration.
# SIGNUP_ENABLED=true

# Public APK hosting on Cloudflare R2 — secrets on the server only:
#   /opt/techlane/deploy/.env.r2
# One-command release (bumps version, builds, uploads R2, registers Update banner):
#   ./scripts/publish-ops-apk.sh
