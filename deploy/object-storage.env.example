# Object storage (Cloudflare R2 or MinIO)
#
# Production uses Cloudflare R2 (shared bucket with APKs):
#   OBJECT_STORAGE_BUCKET=techlane
#   OBJECT_STORAGE_KEY_PREFIX=attachments
#   OBJECT_STORAGE_ENCRYPTION_KEY=<64-char hex>  # AES-GCM; r2.dev is public
#
# The R2 Object Read/Write token cannot CreateBucket. To use a dedicated
# private bucket later: create "techlane-attachments" in the Cloudflare
# dashboard (Public access OFF), then set:
#   OBJECT_STORAGE_BUCKET=techlane-attachments
#   OBJECT_STORAGE_KEY_PREFIX=
#
# OBJECT_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=techlane
# OBJECT_STORAGE_KEY_PREFIX=attachments
# OBJECT_STORAGE_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# OBJECT_STORAGE_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# OBJECT_STORAGE_ENCRYPTION_KEY=<openssl rand -hex 32>
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_PUBLIC_BASE=
#
# MinIO container roots (separate from OBJECT_STORAGE_* when platform uses R2):
# MINIO_ROOT_USER=techlane
# MINIO_ROOT_PASSWORD=...
#
# Local MinIO only:
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=techlane-attachments
# OBJECT_STORAGE_ACCESS_KEY=techlane
# OBJECT_STORAGE_SECRET_KEY=techlanesecret
