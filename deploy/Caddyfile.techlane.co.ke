techlane.co.ke, www.techlane.co.ke {
	encode gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
	@downloadsBare path /downloads /downloads/
	redir @downloadsBare /download permanent
	handle /downloads/* {
		redir https://app.techlane.co.ke{uri} permanent
	}
	@download path /download /download/ /download/index.html
	handle @download {
		root * /opt/techlane/web-dist/web-storefront
		rewrite * /download/index.html
		header Cache-Control "no-store"
		file_server
	}
	handle {
		root * /opt/techlane/web-dist/web-storefront
		@html path / /index.html
		header @html Cache-Control "no-store"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

api.techlane.co.ke {
	# SSE must not be gzipped or buffered — Chrome reports
	# net::ERR_QUIC_PROTOCOL_ERROR on long-lived compressed streams.
	@notSSE not path /api/v1/events/stream
	encode @notSSE gzip
	@sse path /api/v1/events/stream
	handle @sse {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}
